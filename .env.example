# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Cron del job diario de reminders (6 campos, segundos primero). Por defecto 08:00.
REMINDER_CRON="0 0 8 * * *"
# Zona horaria IANA del negocio. Por defecto UTC.
REMINDER_TZ="America/Tegucigalpa"

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=""            # token de usuario de sistema (permanente)
WHATSAPP_PHONE_NUMBER_ID=""         # id del número emisor, no el número
WHATSAPP_API_VERSION="v23.0"        # versión de Graph API; revisar la vigente
WHATSAPP_TEMPLATE_NAME="recordatorio_mantenimiento"
WHATSAPP_TEMPLATE_LANG="es"
WHATSAPP_DEFAULT_COUNTRY_CODE="504" # se antepone a números sin código de país

# Swagger UI en /docs. Activo fuera de producción; en producción solo si es "true".
SWAGGER_ENABLED=""
